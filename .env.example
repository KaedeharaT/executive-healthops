# Local SQLite is the default.  For PostgreSQL, set a SQLAlchemy URL here;
# never commit real credentials or patient data.
DATABASE_URL=sqlite:///./executive_health_ai.db
# Provider configuration placeholders only. Do not add real credentials here.
YUWELL_API_KEY=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
MOCK_WEBHOOK_TOKEN=
APPLE_HEALTH_BRIDGE_TOKEN=
# Optional local-only open-source LLM fallback for unresolved report narrative. It uses the
# same Ollama /api/chat contract as the validated research project; no API key.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=local
LOCAL_LLM_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_LLM_MAX_INPUT_CHARS=3000
# External PHI model calls are prohibited by default.
ALLOW_EXTERNAL_PHI_LLM=false
