# Local SQLite is the default.  For PostgreSQL, set a SQLAlchemy URL here;
# never commit real credentials or patient data.
DATABASE_URL=sqlite:///./executive_health_ai.db
# Report upload limit. The application default is 25 MiB when unset.
MAX_REPORT_UPLOAD_BYTES=26214400
APPLE_HEALTH_BRIDGE_TOKEN=
# Optional semantic fallback for unresolved report narratives. The default provider is
# local Ollama; `openai_compatible` / `compatible_api` uses LLM_API_BASE instead.
# Non-local endpoints stay blocked unless ALLOW_EXTERNAL_PHI_LLM=true is explicitly set
# after privacy review. An API key is never required for the local Ollama path.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=local
LOCAL_LLM_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_API_BASE=
LLM_API_KEY=
LOCAL_LLM_TIMEOUT_SECONDS=600
LOCAL_LLM_MAX_INPUT_CHARS=3000
# External PHI model calls are prohibited by default.
ALLOW_EXTERNAL_PHI_LLM=false
# Governed knowledge retrieval. Partner calls send only a de-identified query
# plus category/audience/jurisdiction filters; member context is never sent.
KNOWLEDGE_PROVIDER=local
KNOWLEDGE_API_BASE=
KNOWLEDGE_API_KEY=
# WHO ICD-11 remains disabled until both credentials are configured. Do not add
# real credentials to this file or to Git.
WHO_ICD11_CLIENT_ID=
WHO_ICD11_CLIENT_SECRET=
